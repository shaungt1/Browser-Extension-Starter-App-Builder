{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "package": "wxt zip",
    "package:firefox": "wxt zip -b firefox",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "verify": "wxt prepare && tsc --noEmit && vitest run && wxt build && wxt build -b firefox"
  },
  "dependencies": {
    "@webext-core/messaging": "4.0.2",
