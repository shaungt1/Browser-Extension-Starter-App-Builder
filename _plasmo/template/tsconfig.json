{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules", "build"],
  "include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx"],
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node", "chrome"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "~*": ["./*"]
    }
  }
}
