{
  "name": "{{PACKAGE_NAME}}",
  "displayName": "{{NAME}}",
  "version": "0.1.0",
  "description": "A secure, cross-browser extension generated with Plasmo.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev --src-path=. --target=chrome-mv3",
    "dev:firefox": "plasmo dev --src-path=. --target=firefox-mv2",
    "build": "plasmo build --src-path=. --target=chrome-mv3",
    "build:firefox": "plasmo build --src-path=. --target=firefox-mv2",
    "package": "plasmo package --src-path=. --target=chrome-mv3",
    "package:firefox": "plasmo package --src-path=. --target=firefox-mv2",
    "typecheck": "plasmo build --src-path=. --target=chrome-mv3 && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "plasmo build --src-path=. --target=chrome-mv3 && playwright test",
    "verify": "plasmo build --src-path=. --target=chrome-mv3 && tsc --noEmit && vitest run && plasmo build --src-path=. --target=firefox-mv2"
  },
  "dependencies": {
    "@plasmohq/storage": "1.15.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "jsdom": "27.0.1",
    "plasmo": "0.90.5",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "manifest": {
    "permissions": ["storage"],
    "browser_specific_settings": {
      "gecko": {
        "id": "{{PACKAGE_NAME}}@local.invalid",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    }
  }
}
